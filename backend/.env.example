
# nginx
NGINX_DATA_PATH=/home/ubuntu
FRONTEND_PAGE=/home/ubuntu

# es
ELASTIC_PASSWORD=change_me
ES_PORT=1200
STACK_VERSION=8.11.3
MEM_LIMIT=8073741824
TIMEZONE='Asia/Shanghai'

DASHSCOPE_API_KEY="your_api_key"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# DATABASE_URL=postgresql://postgres:change_me@gsk_pg:5432/gsk
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/gsk

# PostgreSQL 容器密码（docker-compose.yml 通过 ${POSTGRES_PASSWORD} 插值读取）
POSTGRES_PASSWORD=change_me

# RAGFlow 外部 API（assistant.py / session.py 示例代码使用）
RAGFLOW_API_KEY=your_ragflow_api_key

ES_HOST=http://localhost:1200
# ES_HOST=http://es01:9200
